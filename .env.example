# Pinned Ollama image tag. Check Docker Hub for a current tag.
OLLAMA_VERSION=0.40.5-rc0-rocm

# Comma-separated models to pull
LLM_MODELS=qwen2.5:3b

# Runtime tuning
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m

# Uncomment on NVIDIA hosts with the NVIDIA Container Toolkit installed.
# COMPOSE_FILE=docker-compose.yml:docker-compose.nvidia.yml